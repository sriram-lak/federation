PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Sriram@123
DB_NAME=federation_local_login
DB_SYNC=true

# Local HTTPS (self-signed cert) for manager demo without ngrok
ENABLE_HTTPS=true
PUBLIC_ISSUER_URL=https://localhost:4000

# OIDC client used by Microsoft Entra (External/custom OIDC IdP)
ENTRA_OIDC_CLIENT_ID=entra-federation-client
ENTRA_OIDC_CLIENT_SECRET=entra-federation-secret-change-me
# Comma-separated redirect URIs from Entra custom IdP setup
ENTRA_OIDC_REDIRECT_URIS=https://login.microsoftonline.com/common/oauth2/login

# Optional: keep local broker working during transition
BROKER_CLIENT_ID=federation-broker
BROKER_CLIENT_SECRET=broker-local-secret
BROKER_REDIRECT_URI=http://localhost:4001/oauth/callback
